{
  "name": "kalpavriksha-designs-ops",
  "version": "1.9.30-ssh-independent-certify-deploy-closure",
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-all.mjs",
    "dev:frontend": "node node_modules/vite/bin/vite.js frontend --host 0.0.0.0",
    "postinstall": "npm install --prefix backend --no-audit --no-fund",
    "build": "node node_modules/vite/bin/vite.js build frontend",
    "preview": "node node_modules/vite/bin/vite.js preview frontend",
    "smoke": "node scripts/smoke-check.mjs",
    "data:check": "node scripts/smoke-check.mjs",
    "dev:backend": "cd backend && npm run dev",
    "dev:all": "node scripts/start-all.mjs",
    "start": "node scripts/start-all.mjs",
    "serve": "node scripts/start-all.mjs --production",
    "prod": "npm run build && npm run serve",
    "preflight": "node scripts/preflight.mjs",
    "db:health": "npm run db:integrity --prefix backend",
    "go-live:check": "npm run release:gate",
    "desktop:dev": "KV_DESKTOP_DEV_URL=http://localhost:5173 electron desktop/main.cjs",
    "desktop:build": "npm run build && electron-builder --dir",
    "desktop:pack": "npm run build && electron-builder",
    "doctor": "node scripts/doctor.mjs",
    "clean:cache": "node -e \"console.log('Use scripts/clean-local-cache.ps1 on Windows or scripts/clean-local-cache.sh on Linux/macOS.')\"",
    "verify": "npm run security:package-audit && npm run doctor && npm run guard && npm run audit:production && npm run test:frontend && npm run verify:runtime-shapes && npm run verify:api-contract && npm run verify:task-lifecycle && npm run verify:file-lifecycle && npm run verify:session-isolation && npm run verify:presence-attendance && npm run verify:finance-ledger && npm run verify:persistence-restart && npm run verify:long-session && npm run verify:diagnostics && npm run verify:deployment-resume && npm run verify:fault-soak && npm run verify:certification-local-postgres && npm run verify:operator-deploy && npm run verify:frontend-runtime && npm run test:backend && npm run verify:finance && npm run verify:auth && npm run verify:authorization && npm run verify:database && npm run verify:files && npm run verify:reliability && npm run verify:release && npm run verify:frontend-ux && npm run verify:integration && npm run build",
    "guard": "node scripts/regression-guard.mjs",
    "audit:production": "node scripts/production-regression-audit.mjs",
    "security:package-audit": "node scripts/security-package-audit.mjs",
    "verify:finance": "node scripts/phase-2-finance-durability-check.mjs",
    "verify:auth": "node scripts/phase-3-authentication-check.mjs",
    "verify:authorization": "node scripts/phase-4-authorization-check.mjs",
    "verify:database": "node scripts/phase-5-database-integrity-check.mjs",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:integrity:audit": "npm run db:integrity:audit --prefix backend",
    "db:integrity:reconcile": "npm run db:integrity:reconcile --prefix backend",
    "verify:files": "node scripts/phase-6-file-storage-check.mjs",
    "verify:reliability": "node scripts/phase-7-reliability-check.mjs",
    "backup:create": "npm run backup:create --prefix backend",
    "backup:verify": "npm run backup:verify --prefix backend",
    "backup:status": "npm run backup:status --prefix backend",
    "restore:drill": "npm run restore:drill --prefix backend",
    "test:frontend": "node --test tests/frontend/*.test.mjs",
    "verify:release": "node scripts/phase-8-release-certification-check.mjs",
    "release:clean-install": "node scripts/clean-install-verify.mjs",
    "release:certify": "node scripts/release-certify.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "finance-recovery:plan": "npm run finance-recovery:plan --prefix backend",
    "finance-recovery:apply": "npm run finance-recovery:apply --prefix backend",
    "july30-recovery:plan": "npm run july30-recovery:plan --prefix backend --",
    "july30-recovery:apply": "npm run july30-recovery:apply --prefix backend --",
    "july30-final:plan": "npm run july30-final:plan --prefix backend --",
    "july30-final:apply": "npm run july30-final:apply --prefix backend --",
    "verify:frontend-ux": "node scripts/phase-9-frontend-ux-check.mjs",
    "test:backend": "node --test tests/backend/*.test.mjs",
    "verify:integration": "node scripts/frontend-backend-contract-check.mjs",
    "verify:live-stack": "node scripts/live-stack-check.mjs",
    "verify:matrix": "node scripts/full-release-verifier-matrix.mjs",
    "db:integrity:repair": "npm run db:integrity:repair --prefix backend",
    "deploy:vps": "bash scripts/launch-deploy-1.9.30-vps.sh",
    "verify:frontend-runtime": "node scripts/frontend-runtime-bootstrap-check.mjs",
    "verify:runtime-shapes": "node scripts/phase-11-frontend-runtime-shape-check.mjs",
    "verify:api-contract": "node scripts/phase-12-api-contract-stale-response-check.mjs",
    "verify:task-lifecycle": "node scripts/phase-13-task-lifecycle-idempotency-check.mjs",
    "verify:file-lifecycle": "node scripts/phase-14-file-upload-preview-retention-check.mjs",
    "verify:session-isolation": "node scripts/phase-15-auth-session-browser-isolation-check.mjs",
    "verify:presence-attendance": "node scripts/phase-16-attendance-presence-live-sync-check.mjs",
    "verify:finance-ledger": "node scripts/phase-17-finance-ledger-invariants-check.mjs",
    "verify:persistence-restart": "node scripts/phase-18-runtime-persistence-restart-check.mjs",
    "verify:long-session": "node scripts/phase-19-performance-memory-long-session-check.mjs",
    "verify:diagnostics": "node scripts/phase-20-runtime-error-diagnostics-check.mjs",
    "verify:deployment-resume": "node scripts/phase-21-resume-aware-deployment-check.mjs",
    "verify:fault-soak": "node scripts/phase-22-end-to-end-fault-soak-check.mjs",
    "verify:certification-local-postgres": "node scripts/phase-23-production-local-postgres-certification-check.mjs",
    "verify:operator-deploy": "node scripts/phase-24-operator-safe-certify-deploy-check.mjs",
    "certify-deploy:vps": "bash scripts/launch-certify-and-deploy-1.9.30-vps.sh"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "lucide-react": "1.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "8.1.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "autoprefixer": "10.5.2",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "postcss": "8.5.16",
    "tailwindcss": "3.4.19",
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "in.co.kalpvriksha.ops",
    "productName": "Kalpavriksha Ops",
    "directories": {
      "output": "release"
    },
    "files": [
      "frontend/dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  }
}
