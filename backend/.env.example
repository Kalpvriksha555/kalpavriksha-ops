# Local development only. Copy to backend/.env and replace placeholders.
NODE_ENV=development
PORT=8080
BIND_HOST=127.0.0.1
DATABASE_URL=postgresql://kalpavriksha:change-me@127.0.0.1:5432/kalpavriksha_dev
DB_SSL=false
ALLOW_JSON_FALLBACK=false
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8080
SESSION_COOKIE_NAME=kv_session
SESSION_TTL_HOURS=12
ATTENDANCE_TIMEZONE=Asia/Kolkata
MAX_UPLOAD_SIZE_MB=100
MAX_UPLOAD_FILES=20
KALPA_FILE_STORAGE_ROOT=/absolute/path/to/kalpavriksha-private-files
FILE_STORAGE_PERSISTENT=false
KALPA_BACKUP_ROOT=/absolute/path/to/kalpavriksha-backups
BACKUP_REQUIRED=false
BACKUP_STORAGE_PERSISTENT=false
RELEASE_CERTIFICATE_PATH=/absolute/path/to/release-certification.json
ALLOW_LOCAL_EMAIL_OTP=true
# One-time empty-database bootstrap only; remove immediately after first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-immediately
BOOTSTRAP_ADMIN_NAME=Administrator
